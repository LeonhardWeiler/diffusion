<?xml version="1.0" encoding="utf-8"?><!--
   The settings store holds the ssh private key, its passphrase and the
   password or token of the remote, which must not leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
